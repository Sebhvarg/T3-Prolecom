APP_NAME=Prolecom
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=error

# Base de datos — sobreescrita por docker-compose environment
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=prolecom
DB_USERNAME=root
DB_PASSWORD=root

# Broadcasting — Reverb WebSocket
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=1
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# Colas
QUEUE_CONNECTION=database

# Caché y sesiones
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

# Judge0 (sobreescrita por docker-compose environment)
JUDGE0_URL=http://judge0-server:2358
JUDGE0_HOST=judge0-server
JUDGE0_TOKEN=
